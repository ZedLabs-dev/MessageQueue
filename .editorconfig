# ESE.MessageQueue house style.
# Enforced in build via EnforceCodeStyleInBuild (Directory.Build.props) and in CI via
# `dotnet format --verify-no-changes`. Rules at `warning` fail the build (TreatWarningsAsErrors).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xml,config}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sln]
indent_style = tab
end_of_line = unset
charset = unset

[*.cs]
indent_size = 4

# ---------------------------------------------------------------------------
# Layout
# ---------------------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
# Braceless single-line `if` bodies are used in the codebase; not enforced either way.
csharp_prefer_braces = true:silent

# ---------------------------------------------------------------------------
# Modifiers: omit default accessibility (no `private` on members, no `internal` on nested types)
# ---------------------------------------------------------------------------
dotnet_style_require_accessibility_modifiers = omit_if_default:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:suggestion
dotnet_style_readonly_field = true:warning

# ---------------------------------------------------------------------------
# `this.` only where needed to disambiguate
# ---------------------------------------------------------------------------
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent
dotnet_style_qualification_for_event = false:silent

# ---------------------------------------------------------------------------
# var / language keywords / expressions
# ---------------------------------------------------------------------------
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_methods = false:silent
csharp_style_expression_bodied_constructors = false:silent
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion

# ---------------------------------------------------------------------------
# Naming
#   - private/internal instance fields: camelCase, NO underscore prefix (`readonly string queueName;`)
#   - static readonly and const fields: PascalCase (`static readonly JsonSerializerOptions JsonOptions`)
#   - types, methods, properties, events: PascalCase; interfaces: I-prefixed
#   - parameters and locals: camelCase
# ---------------------------------------------------------------------------
dotnet_naming_rule.interfaces_i_prefix.symbols = interface_symbols
dotnet_naming_rule.interfaces_i_prefix.style = i_prefix_pascal
dotnet_naming_rule.interfaces_i_prefix.severity = warning

dotnet_naming_rule.types_pascal.symbols = type_symbols
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_rule.types_pascal.severity = warning

dotnet_naming_rule.const_fields_pascal.symbols = const_field_symbols
dotnet_naming_rule.const_fields_pascal.style = pascal
dotnet_naming_rule.const_fields_pascal.severity = warning

dotnet_naming_rule.static_readonly_fields_pascal.symbols = static_readonly_field_symbols
dotnet_naming_rule.static_readonly_fields_pascal.style = pascal
dotnet_naming_rule.static_readonly_fields_pascal.severity = warning

dotnet_naming_rule.private_fields_camel.symbols = private_field_symbols
dotnet_naming_rule.private_fields_camel.style = camel
dotnet_naming_rule.private_fields_camel.severity = warning

dotnet_naming_rule.members_pascal.symbols = member_symbols
dotnet_naming_rule.members_pascal.style = pascal
dotnet_naming_rule.members_pascal.severity = warning

dotnet_naming_rule.parameters_camel.symbols = parameter_symbols
dotnet_naming_rule.parameters_camel.style = camel
dotnet_naming_rule.parameters_camel.severity = warning

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.const_field_symbols.applicable_kinds = field
dotnet_naming_symbols.const_field_symbols.required_modifiers = const
dotnet_naming_symbols.static_readonly_field_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field_symbols.required_modifiers = static, readonly
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private, internal, protected, protected_internal, private_protected
dotnet_naming_symbols.member_symbols.applicable_kinds = method, property, event
dotnet_naming_symbols.parameter_symbols.applicable_kinds = parameter, local

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_style.i_prefix_pascal.capitalization = pascal_case
dotnet_naming_style.i_prefix_pascal.required_prefix = I

# Naming rule violations fail the build (IDE1006 is not promoted by EnforceCodeStyleInBuild on its own).
dotnet_diagnostic.IDE1006.severity = warning

# ---------------------------------------------------------------------------
# Analyzer severities (AnalysisLevel = latest-recommended)
# ---------------------------------------------------------------------------

# Won't fix: "MessageQueue" is the domain term; IMessageQueue<T>, RabbitMqMessageQueue<T>, etc.
# are the public API and intentionally end in "Queue".
dotnet_diagnostic.CA1711.severity = none

# Deferred to OPTIMIZATION-PLAN Phase 4 (B7: dispose rework / IAsyncDisposable / idempotent dispose).
# TelemetryActivity needs a proper protected Dispose(bool) pattern, which is a public-API change.
dotnet_diagnostic.CA1816.severity = suggestion

[MessageQueue.Tests/**.cs]
# Test method names follow the `When_<Condition_Or_Action>` BDD convention, and test classes
# may be named for the context under test (e.g. `Given_a_rabbitmq_queue`).
dotnet_diagnostic.CA1707.severity = none
dotnet_naming_rule.members_pascal.severity = none
dotnet_naming_rule.types_pascal.severity = none
