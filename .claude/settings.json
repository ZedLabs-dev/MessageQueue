{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose -f docker/docker-compose.dev.yml config -q)",
      "Bash(docker compose -f docker/docker-compose.dev.yml --profile servicebus config -q)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet list package:*)",
      "Bash(dotnet list ZedLabs.MessageQueue.sln package:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml up:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml ps:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml logs:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml down)",
      "Bash(docker compose -f docker/docker-compose.dev.yml --profile servicebus up:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml --profile servicebus ps:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml --profile servicebus logs:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml --profile servicebus down)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(dotnet pack:*)",
      "Bash(dotnet tool restore)",
      "Bash(scripts/coverage.sh:*)",
      "Bash(scripts/mutate.py:*)",
      "Bash(dotnet list ZedLabs.MessageQueue.sln package --outdated:*)"
    ],
    "deny": [
      "Bash(docker compose -f docker/docker-compose.dev.yml down -v:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml down --volumes:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml --profile servicebus down -v:*)",
      "Bash(docker compose -f docker/docker-compose.dev.yml --profile servicebus down --volumes:*)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Edit(**/packages.lock.json)",
      "Write(**/packages.lock.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-cs.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
