{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet list package:*)",
      "Bash(dotnet list ESE.MessageQueue.sln package:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml up:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml ps:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml logs:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml config:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml down)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml --profile servicebus up:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml --profile servicebus ps:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml --profile servicebus logs:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml --profile servicebus config:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml --profile servicebus down)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml down -v:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml down --volumes:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml --profile servicebus down -v:*)",
      "Bash(docker compose -f MessageQueue/docker-compose.dev.yml --profile servicebus down --volumes:*)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "Edit(**/packages.lock.json)",
      "Write(**/packages.lock.json)"
    ]
  }
}
