<Project Sdk="Microsoft.NET.Sdk">

    <!-- A provider written the way a third party would write one: against the public provider SPI only
         (ZedLabs.MessageQueue.Providers). Core grants it no InternalsVisibleTo, so it proves the SPI is sufficient
         (ADR 0015). Not packed; the test project exercises it. -->
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <AssemblyName>ZedLabs.MessageQueue.Samples.LoopbackProvider</AssemblyName>
        <RootNamespace>ZedLabs.MessageQueue.Samples.LoopbackProvider</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\ZedLabs.MessageQueue\ZedLabs.MessageQueue.csproj" />
    </ItemGroup>

</Project>
