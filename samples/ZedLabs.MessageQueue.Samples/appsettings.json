{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "MessageQueue": {
    "Provider": "InMemory",
    "QueueName": "orders",
    "Retry": {
      "MaxRetries": 3,
      "InitialDelay": "00:00:01",
      "MaxDelay": "00:00:05"
    }
  },
  "Sample": {
    "OrdersToPublish": 3,
    "DeadLetters": "Peek",
    "DeadLetterDelay": "00:00:05"
  },
  "Telemetry": {
    "ConsoleExporter": true
  }
}
