# Copy to docker/.env (git-ignored) and adjust. Used by docker-compose.dev.yml.

# RabbitMQ for manual experiments. The test suite does not use it: it starts its own container via Testcontainers.
# REQUIRED: replace both placeholders with your own values before the first `docker compose up` (RabbitMQ stores the
# user in its data volume on first start). docker compose refuses to start when either variable is unset or empty,
# and no default credentials exist. Never commit docker/.env.
RABBITMQ_USER=change-me
RABBITMQ_PASS=change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Azure Service Bus emulator + its SQL Server.
# ACCEPT_EULA=Y accepts the emulator and SQL Server license terms:
#   https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
ACCEPT_EULA=N
# REQUIRED for the servicebus profile: replace the placeholder with your own password. SQL Server's policy (>= 8
# chars with upper, lower, digit and symbol) rejects the placeholder, so SQL Server will not start until you do.
MSSQL_SA_PASSWORD=change-me
SQL_WAIT_INTERVAL=15
ASB_EMULATOR_AMQP_PORT=5673
ASB_EMULATOR_MANAGEMENT_PORT=5300

# For the ASB integration tests (export in your shell; they skip when unset). Queue defaults to integration-test-queue,
# override with MQ_ASB_QUEUE_NAME.
# MQ_ASB_CONNECTION_STRING="Endpoint=sb://localhost:5673;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
