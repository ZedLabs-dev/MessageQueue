{
  "description": "Phase 7 review fixes: health results without exceptions (S5), consume-side sanitizing, inbound size cap (S9), retry-death trust, dispatcher SPI hardening, transport-error telemetry (B6), registration checks, sample content root, JSON depth.",
  "defaults": { "filter": "Category=Unit" },
  "mutants": [
    { "id": "H1", "name": "generic health check attaches the exception",
      "file": "src/ZedLabs.MessageQueue/HealthChecks/MessageQueueHealthCheck.cs",
      "find": "return HealthCheckResult.Unhealthy($\"Message queue '{queueName}' health check failed.\");",
      "replace": "return HealthCheckResult.Unhealthy($\"Message queue '{queueName}' health check failed.\", ex);" },
    { "id": "H2", "name": "RabbitMQ health check attaches the exception",
      "file": "src/ZedLabs.MessageQueue.RabbitMQ/HealthChecks/RabbitMqHealthCheck.cs",
      "find": "return HealthCheckResult.Unhealthy(Failed);",
      "replace": "return HealthCheckResult.Unhealthy(Failed, ex);" },
    { "id": "H3", "name": "metrics check attaches the not-found exception",
      "file": "src/ZedLabs.MessageQueue.AzureServiceBus/HealthChecks/AzureServiceBusMetricsHealthCheck.cs",
      "find": "return HealthCheckResult.Unhealthy(NotFound);",
      "replace": "return HealthCheckResult.Unhealthy(NotFound, ex);" },
    { "id": "H4", "name": "standalone ASB check accepts a malformed connection string",
      "file": "src/ZedLabs.MessageQueue.AzureServiceBus/HealthChecks/AzureServiceBusHealthCheckExtensions.cs",
      "find": "if (string.IsNullOrWhiteSpace(connectionString) || !AzureServiceBusConnections.IsValidConnectionString(connectionString))",
      "replace": "if (string.IsNullOrWhiteSpace(connectionString))" },
    { "id": "R1", "name": "inbound body cap ignores MaxMessageSizeBytes",
      "file": "src/ZedLabs.MessageQueue.RabbitMQ/RabbitMqConnections.cs",
      "find": "(uint)Math.Max(config.MaxMessageSizeBytes, BrokerDefaultMaxMessageSize)",
      "replace": "(uint)BrokerDefaultMaxMessageSize" },
    { "id": "R2", "name": "no header count cap on consume",
      "file": "src/ZedLabs.MessageQueue/Processing/DeliveryText.cs",
      "find": "if (headers.Count >= PublishOptions.MaxHeaders\n            || ",
      "replace": "if (" },
    { "id": "R3", "name": "broker message id not sanitized",
      "file": "src/ZedLabs.MessageQueue/Processing/DeliveryText.cs",
      "find": "        var clean = new string(raw.Where(c => !char.IsControl(c)).Take(PublishOptions.MaxMessageIdLength).ToArray());\n        return clean;",
      "replace": "        return raw;" },
    { "id": "R4", "name": "any death of a retry queue counts, not only expiry",
      "file": "src/ZedLabs.MessageQueue.RabbitMQ/RabbitMqMessageQueue.cs",
      "find": "death.TryGetValue(\"reason\", out var reason) && HeaderText(reason) == \"expired\"",
      "replace": "death.TryGetValue(\"reason\", out var reason)" },
    { "id": "D1", "name": "dispatcher keeps the provider's mutable config",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageDispatcher.cs",
      "find": "this.config = config with { };",
      "replace": "this.config = config;" },
    { "id": "D2", "name": "default dead-letter reason has a null code",
      "file": "src/ZedLabs.MessageQueue/Providers/IDeliveryActions.cs",
      "find": "public string Code => code ?? DeadLetterReasons.DeliveryFailed;",
      "replace": "public string Code => code!;" },
    { "id": "D3", "name": "dispatcher does not check its handler",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageDispatcher.cs",
      "find": "        ArgumentNullException.ThrowIfNull(handler);\n",
      "replace": "" },
    { "id": "T1", "name": "processor errors not counted",
      "file": "src/ZedLabs.MessageQueue.AzureServiceBus/AzureServiceBusMessageQueue.cs",
      "find": "            telemetry.RecordTransportError(consumeTarget, errorType);",
      "replace": "            _ = errorType;" },
    { "id": "T2", "name": "transport errors not tagged with error.type",
      "file": "src/ZedLabs.MessageQueue/Telemetry/OpenTelemetry/OpenTelemetryProvider.cs",
      "find": "transportErrors.Add(1, Tags(target, \"process\", errorType, consumer: true));",
      "replace": "transportErrors.Add(1, Tags(target, \"process\", null, consumer: true));" },
    { "id": "C1", "name": "provider registered as a type is silently ignored",
      "file": "src/ZedLabs.MessageQueue/Extensions/MessageQueueServiceCollectionExtensions.cs",
      "find": "if (descriptors.Find(d => d.IsKeyedService || d.ImplementationInstance is null) is { } invisible)",
      "replace": "if (descriptors.Find(d => false) is { } invisible)" },
    { "id": "S1", "name": "sample reads settings from the working directory",
      "file": "samples/ZedLabs.MessageQueue.Samples/SampleHost.cs",
      "find": "            ContentRootPath = AppContext.BaseDirectory\n",
      "replace": "" },
    { "id": "J1", "name": "JSON depth limit raised",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageSerializer.cs",
      "find": "MaxDepth = 64",
      "replace": "MaxDepth = 256" },
    { "id": "G1", "name": "hosted service does not unsubscribe (in-flight processor never cancelled)",
      "file": "src/ZedLabs.MessageQueue/Hosting/MessageQueueHostedService.cs",
      "find": "                await subscriber.UnsubscribeAsync(cancellationToken);",
      "replace": "                await Task.CompletedTask;" }
  ]
}
