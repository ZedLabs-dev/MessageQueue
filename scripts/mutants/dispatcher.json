{
  "description": "Shared consumer pipeline and telemetry (ADR 0004, ADR 0013). Adapted from the Phase 6 telemetry review set.",
  "defaults": { "filter": "Category=Unit" },
  "mutants": [
    { "id": "D01", "name": "dispatcher does not extract the parent",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageDispatcher.cs",
      "find": "var activity = StartActivity(context, ExtractParent(context));",
      "replace": "var activity = StartActivity(context, null);" },
    { "id": "D02", "name": "retry counter not incremented",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageDispatcher.cs",
      "find": "Guard((telemetry, target, attempt), static s => s.telemetry.RecordMessageRetried(s.target, s.attempt + 1));",
      "replace": "" },
    { "id": "D03", "name": "ambient Activity.Current not cleared",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageDispatcher.cs",
      "find": "        Activity.Current = null;\n",
      "replace": "" },
    { "id": "D04", "name": "oversized bodies are deserialized",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageDispatcher.cs",
      "find": "if (body.Length > config.MaxMessageSizeBytes)",
      "replace": "if (body.Length > int.MaxValue - 1)" },
    { "id": "D05", "name": "dead-lettering ignores EnableDeadLetterQueue",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageDispatcher.cs",
      "find": "if (!config.EnableDeadLetterQueue)",
      "replace": "if (false)" },
    { "id": "D06", "name": "next attempt not incremented",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageDispatcher.cs",
      "find": "await actions.RescheduleAsync(delay, attempt + 1, stopping);",
      "replace": "await actions.RescheduleAsync(delay, attempt, stopping);" },
    { "id": "D07", "name": "publish injection failure not guarded",
      "file": "src/ZedLabs.MessageQueue/Providers/PublishTelemetry.cs",
      "find": "        catch (Exception ex)\n        {\n            DispatcherLog.PublishTelemetryFailed(logger!, target!.Destination, ex);\n            return NoHeaders;",
      "replace": "        catch (Exception ex) when (ex is OperationCanceledException)\n        {\n            DispatcherLog.PublishTelemetryFailed(logger!, target!.Destination, ex);\n            return NoHeaders;" },
    { "id": "D08", "name": "reserved header prefix not enforced",
      "file": "src/ZedLabs.MessageQueue/Providers/PublishValidation.cs",
      "find": "name.StartsWith(ReservedPrefix, StringComparison.OrdinalIgnoreCase)",
      "replace": "name.StartsWith(ReservedPrefix, StringComparison.Ordinal)" },
    { "id": "D09", "name": "MessagePack trusts broker input",
      "file": "src/ZedLabs.MessageQueue/Providers/MessageSerializer.cs",
      "find": ".WithSecurity(MessagePackSecurity.UntrustedData);",
      "replace": ".WithSecurity(MessagePackSecurity.TrustedData);" }
  ]
}
