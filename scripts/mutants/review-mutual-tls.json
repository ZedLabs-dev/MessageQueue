{
  "description": "Reviewer's adversarial set for the mutual-TLS change: chain rules (basic constraints, path length, name constraints, anchors never taken from what the broker sends, no reuse of the TLS stack's chain, no AIA downloads), the connect-time insecure-acceptance gate, per-name health check instances and concurrent first loads. U01 (P06b, P07) and U11 are killed on Linux only for some specs: U01 is also killed on macOS by the path-length spec; U11 only on Linux, where X509Chain downloads AIA issuers (run it in the Linux SDK container).",
  "defaults": {
    "filter": "Category=Unit&(FullyQualifiedName~ESE.MessageQueue.Tests.RabbitMQ|FullyQualifiedName~ESE.MessageQueue.Tests.HealthChecks)"
  },
  "mutants": [
    {
      "id": "U01",
      "name": "chain ignores invalid basic constraints (a CA-issued client or server leaf can sign a broker certificate)",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);",
      "replace": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);\n        chain.ChainPolicy.VerificationFlags = X509VerificationFlags.IgnoreInvalidBasicConstraints;"
    },
    {
      "id": "U02",
      "name": "chain allows an unknown certificate authority",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);",
      "replace": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);\n        chain.ChainPolicy.VerificationFlags = X509VerificationFlags.AllowUnknownCertificateAuthority;"
    },
    {
      "id": "U03",
      "name": "chain ignores validity periods",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);",
      "replace": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);\n        chain.ChainPolicy.VerificationFlags = X509VerificationFlags.IgnoreNotTimeValid;"
    },
    {
      "id": "U04",
      "name": "chain ignores wrong key usage",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);",
      "replace": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);\n        chain.ChainPolicy.VerificationFlags = X509VerificationFlags.IgnoreWrongUsage;"
    },
    {
      "id": "U05",
      "name": "chain ignores revocation-unknown and CTL time (revocation is NoCheck)",
      "equivalent": "RevocationMode is NoCheck, so no revocation status is ever produced",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);",
      "replace": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);\n        chain.ChainPolicy.VerificationFlags = X509VerificationFlags.IgnoreEndRevocationUnknown | X509VerificationFlags.IgnoreCtlNotTimeValid;"
    },
    {
      "id": "U06",
      "name": "chain ignores invalid name constraints / policy",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);",
      "replace": "chain.ChainPolicy.ApplicationPolicy.Add(ServerAuthentication);\n        chain.ChainPolicy.VerificationFlags = X509VerificationFlags.IgnoreInvalidPolicy | X509VerificationFlags.IgnoreInvalidName;"
    },
    {
      "id": "U07",
      "name": "self-signed certificates the broker sends are trusted as anchors",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "            chain.ChainPolicy.ExtraStore.AddRange(presented.ChainPolicy.ExtraStore);",
      "replace": "        {\n            chain.ChainPolicy.ExtraStore.AddRange(presented.ChainPolicy.ExtraStore);\n            foreach (var sent in presented.ChainPolicy.ExtraStore)\n                if (sent.SubjectName.RawData.AsSpan().SequenceEqual(sent.IssuerName.RawData))\n                    chain.ChainPolicy.CustomTrustStore.Add(sent);\n        }"
    },
    {
      "id": "U08",
      "name": "every certificate the broker sends is trusted as an anchor",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "            chain.ChainPolicy.ExtraStore.AddRange(presented.ChainPolicy.ExtraStore);",
      "replace": "        {\n            chain.ChainPolicy.ExtraStore.AddRange(presented.ChainPolicy.ExtraStore);\n            chain.ChainPolicy.CustomTrustStore.AddRange(presented.ChainPolicy.ExtraStore);\n        }"
    },
    {
      "id": "U09",
      "name": "system trust plus anchors as extra store",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "chain.ChainPolicy.TrustMode = X509ChainTrustMode.CustomRootTrust;\n        chain.ChainPolicy.CustomTrustStore.AddRange(anchors);",
      "replace": "chain.ChainPolicy.ExtraStore.AddRange(anchors);"
    },
    {
