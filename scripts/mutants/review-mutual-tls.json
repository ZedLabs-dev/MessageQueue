    {
      "id": "U19",
      "name": "validation chain uses the leaf's own chain from SslStream when it has elements",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "        if (!chain.Build(leaf ?? copy!))",
      "replace": "        if (presented is not null && presented.ChainElements.Count > 0 && presented.ChainStatus.All(s => s.Status == X509ChainStatusFlags.NoError))\n            return errors;\n        if (!chain.Build(leaf ?? copy!))"
