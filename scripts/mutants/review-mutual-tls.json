    {
      "id": "U20",
      "name": "CA file read as DER only when the PEM import found nothing (lenient)",
      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqTrustAnchors.cs",
      "find": "            if (RabbitMqClientCertificates.IsPem(content))\n                anchors.ImportFromPem(Encoding.UTF8.GetString(content));\n            else\n                anchors.Add(X509CertificateLoader.LoadCertificate(content));",
