      "find": "if (TlsOf(config).AcceptablePolicyErrors != SslPolicyErrors.None && !TlsOf(config).AllowInsecureCertificates)",
      "replace": "if (TlsOf(config).AcceptablePolicyErrors != SslPolicyErrors.None && false)"
