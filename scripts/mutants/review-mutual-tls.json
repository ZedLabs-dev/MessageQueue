      "file": "src/ESE.MessageQueue.RabbitMQ/RabbitMqConnections.cs",
      "find": "        var errors = Validate(config, loadClientCertificate: false);\n        if (errors.Count > 0)",
      "replace": "        var errors = Validate(config, loadClientCertificate: false);\n        errors.RemoveAll(e => e.StartsWith(\"Tls:AcceptablePolicyErrors accepts\"));\n        if (errors.Count > 0)"
