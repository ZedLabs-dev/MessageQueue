    {
      "id": "U18",
      "name": "registration copy removed and the check keeps the caller's object (both copies dropped)",
      "file": "src/ESE.MessageQueue.RabbitMQ/HealthChecks/RabbitMqHealthCheck.cs",
      "find": "            this.tls = tls with { };",
      "replace": "            this.tls = tls;"
