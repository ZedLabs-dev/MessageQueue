# Copy to MessageQueue/.env (git-ignored) and adjust. Used by docker-compose.dev.yml.

# RabbitMQ. The current integration tests expect admin/password123 on localhost:5672.
RABBITMQ_USER=admin
RABBITMQ_PASS=password123
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Azure Service Bus emulator + its SQL Server.
# ACCEPT_EULA=Y accepts the emulator and SQL Server license terms:
#   https://github.com/Azure/azure-service-bus-emulator-installer/blob/main/EMULATOR_EULA.txt
ACCEPT_EULA=N
# SQL Server password policy: >= 8 chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe-Local-Only-1
SQL_WAIT_INTERVAL=15
ASB_EMULATOR_AMQP_PORT=5673
ASB_EMULATOR_MANAGEMENT_PORT=5300

# For the ASB integration tests:
# AZURE_SERVICEBUS_CONNECTION_STRING="Endpoint=sb://localhost:5673;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;"
