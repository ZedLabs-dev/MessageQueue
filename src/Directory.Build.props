<Project>

  <!-- Settings for the shipped packages only; samples, tests and benchmarks keep the root settings. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- ADR 0016: no previous version exists, so validation checks the package's own consistency only;
         set PackageValidationBaselineVersion after 1.0.0 ships. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup Label="Docs and API lock">
    <!-- CS1591 (missing XML comment) is an error through TreatWarningsAsErrors; options classes are exempted by
         file in .editorconfig (CLAUDE.md "Code conventions"). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Symbols and SourceLink">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <!-- SourceLink needs a GitHub 'origin'; local clones, forks with other hosts and source archives must still
         build under TreatWarningsAsErrors, so it runs only for CI builds, which produce the published packages. -->
    <EnableSourceLink Condition="'$(ContinuousIntegrationBuild)' != 'true'">false</EnableSourceLink>
    <EnableSourceControlManagerQueries Condition="'$(ContinuousIntegrationBuild)' != 'true'">false</EnableSourceControlManagerQueries>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../NOTICE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- RS0016/RS0017 (and the rest of RS00xx) fail the build on any public API change not recorded in PublicAPI.*.txt. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <!-- The .NET SDK bundles SourceLink; the explicit reference pins its version under CPM and Dependabot. -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
