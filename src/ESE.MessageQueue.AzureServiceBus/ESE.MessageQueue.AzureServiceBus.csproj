<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>ESE.MessageQueue.AzureServiceBus</AssemblyName>
        <RootNamespace>ESE.MessageQueue.AzureServiceBus</RootNamespace>
        <Description>Azure Service Bus provider for ESE.MessageQueue: queues and topic subscriptions, scheduled-retry backoff, byte-aware batching, Entra ID (DefaultAzureCredential) or connection strings, and a least-privilege peek health check.</Description>
        <PackageTags>$(PackageTags);azure;servicebus;azure-service-bus</PackageTags>
    </PropertyGroup>


    <!-- Tests and benchmarks see internals in development builds only; `dotnet pack` (which sets _IsPacking) builds the
         shipped assembly without them (ADR 0016). -->
    <ItemGroup Condition="'$(_IsPacking)' != 'true'">
        <InternalsVisibleTo Include="ESE.MessageQueue.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity" />
        <PackageReference Include="Azure.Messaging.ServiceBus" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ESE.MessageQueue\ESE.MessageQueue.csproj" />
    </ItemGroup>

</Project>
